# Postgres connection string (Neon / Vercel Postgres / Railway Postgres / local).
DATABASE_URL=postgres://plott:plott@localhost:5432/plott

# Random secret for signing sessions: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public URL of the app. Optional on Vercel and Railway (detected automatically),
# required anywhere else, e.g. https://wish.example.com
BETTER_AUTH_URL=http://localhost:3000

# Optional: email delivery through Resend (https://resend.com).
# Without it, magic-link login and password reset are hidden in production
# and the links are printed to the server log in development.
RESEND_API_KEY=
EMAIL_FROM="PLOTT <hello@example.com>"
# Where replies to the app's emails land (a real inbox you read).
EMAIL_REPLY_TO=

# Comma-separated emails of people who may send the relaunch announcement from their profile.
ADMIN_EMAILS=
